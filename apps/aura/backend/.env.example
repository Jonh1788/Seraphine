# Aura backend configuration — copy to .env and fill in.

# --- Server
AURA_HOST=0.0.0.0
AURA_PORT=8001
AURA_RELOAD=false

# --- Storage
AURA_SQLITE_PATH=./data/aura.sqlite

# --- Auth
# REQUIRED in production. Generate with: openssl rand -hex 32
AURA_JWT_SECRET=change-me-in-production
AURA_JWT_EXPIRES_SECONDS=604800

# --- LLM (Anthropic direct, no CLIProxy)
AURA_ANTHROPIC_API_KEY=
AURA_ANTHROPIC_MODEL=claude-sonnet-4-5
