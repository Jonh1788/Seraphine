# Caddy — TLS edge for Aura. Let's Encrypt certs are auto-provisioned
# on first start (HTTP-01 challenge on :80) and renewed automatically.
#
# The `frontend` hostname resolves inside the compose network to the
# nginx container, which serves the SPA and proxies API paths to the
# backend container.

{
    # Tighten the default per-request body cap (nginx already allows 20M
    # for uploads; Caddy's default is unlimited, but we match upstream).
    servers {
        max_header_size 64kb
    }
}

app.minha-aura.com {
    encode zstd gzip
    reverse_proxy frontend:80 {
        flush_interval -1        # flush responses immediately (SSE)
    }
}

# Apex redirect — no landing page yet, send visitors to the app.
minha-aura.com, www.minha-aura.com {
    redir https://app.minha-aura.com{uri} permanent
}
