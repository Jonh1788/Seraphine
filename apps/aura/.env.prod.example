# Copy to .env.prod and fill in real values.
# .env.prod is git-ignored — never commit secrets.

# --- Auth
# Generate with: openssl rand -hex 32
AURA_JWT_SECRET=change-me-in-production

# --- LLM
AURA_ANTHROPIC_API_KEY=sk-ant-...
AURA_ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Google OAuth
# Callback URL must exactly match what's registered in Google Cloud Console.
AURA_GOOGLE_CLIENT_ID=
AURA_GOOGLE_CLIENT_SECRET=
AURA_GOOGLE_OAUTH_REDIRECT_URL=https://app.minha-aura.com/google/oauth/callback
