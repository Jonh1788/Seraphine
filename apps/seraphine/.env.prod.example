# Seraphine backend production environment — copy to `.env.prod` and fill.
# `.env.prod` is git-ignored. Secrets here are read by docker compose.

# ── LLM (Claude Max via Claude Code OAuth on the VPS) ─────────────
SERAPHINE_LLM_BACKEND=claude_max
SERAPHINE_ANTHROPIC_MODEL=claude-opus-4-7
# Claude Max tokens live at /root/.claude/.credentials.json on the host
# and are mounted read-only into the container — no value to set here.

# ── TTS (ElevenLabs) ──────────────────────────────────────────────
SERAPHINE_TTS_BACKEND=elevenlabs
SERAPHINE_ELEVENLABS_API_KEY=
SERAPHINE_ELEVENLABS_VOICE_ID=
SERAPHINE_ELEVENLABS_MODEL_ID=eleven_v3

# ── STT (remote only on the VPS — MLX Whisper is Apple-only) ──────
SERAPHINE_STT_BACKEND=remote
# Point at a faster-whisper HTTP service if one is reachable; otherwise
# leave the backend running without STT (the Mac client transcribes
# locally before sending text).
SERAPHINE_STT_REMOTE_BASE_URL=http://127.0.0.1:8012

# ── Embeddings (Ollama) ───────────────────────────────────────────
# If Ollama is not deployed on the VPS, memory recall will degrade
# gracefully but the backend still starts.
SERAPHINE_OLLAMA_BASE_URL=http://host.docker.internal:11434
SERAPHINE_EMBEDDING_MODEL=nomic-embed-text

# ── Google Workspace ──────────────────────────────────────────────
# Optional — leave blank to disable Google integrations.
SERAPHINE_GOOGLE_CLIENT_ID=
SERAPHINE_GOOGLE_CLIENT_SECRET=

# ── WhatsApp bridge ───────────────────────────────────────────────
# Leave blank unless you run the WhatsApp bridge on the VPS too.
SERAPHINE_WHATSAPP_BRIDGE_URL=

# ── Wise ──────────────────────────────────────────────────────────
SERAPHINE_WISE_API_KEY=
SERAPHINE_WISE_SANDBOX=true

# ── Web Push (optional) ───────────────────────────────────────────
SERAPHINE_VAPID_PUBLIC_KEY=
SERAPHINE_VAPID_PRIVATE_KEY=

# ── CORS ──────────────────────────────────────────────────────────
# Restrict to the frontends you actually ship.
SERAPHINE_CORS_ORIGINS=https://sera.jonhdev.io
