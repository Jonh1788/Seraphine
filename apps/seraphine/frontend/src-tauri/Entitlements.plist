<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    macOS Seraphine entitlements (non-sandboxed Developer ID build).

    Apple's Developer portal does NOT support HealthKit on macOS App
    IDs (platform support is iOS/visionOS/watchOS only), so the macOS
    desktop build intentionally does NOT request the HealthKit
    entitlement. HealthKit real data flows through the iOS companion
    (`pnpm tauri ios build`) which has its own
    `gen/apple/seraphine-desktop_iOS/seraphine-desktop_iOS.entitlements`
    with HealthKit properly requested.

    The Mac app uses the Swift bridge in mock mode (synthetic data) or
    reads whatever the iPhone pushed to the backend via
    `POST /health/snapshot`.
  -->

  <!-- get-task-allow must be true for Apple Development certificates
       so the debugger can attach. For Developer ID (distribution) builds
       this should be flipped off and Hardened Runtime entitlements
       added. -->
  <key>get-task-allow</key>
  <true/>
</dict>
</plist>
