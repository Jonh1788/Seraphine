{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seraphine",
  "version": "0.1.0",
  "identifier": "io.jonhdev.seraphine",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Seraphine",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "visible": true,
        "url": "/"
      },
      {
        "label": "quick-capture",
        "title": "Quick Capture",
        "width": 520,
        "height": 220,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "center": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": true,
        "acceptFirstMouse": true,
        "url": "/quick-capture.html"
      },
      {
        "label": "avatar-companion",
        "title": "Seraphine",
        "width": 320,
        "height": 480,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "center": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": true,
        "shadow": false,
        "url": "/avatar-companion.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first personal assistant",
    "longDescription": "Seraphine — voz, avatar, finanças, agenda e mais. Roda local no seu Mac.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "exceptionDomain": "",
      "signingIdentity": "Apple Development: Jonathan Santos (68MJSVTU7A)",
      "providerShortName": "CDX69HJKGH"
    }
  }
}
