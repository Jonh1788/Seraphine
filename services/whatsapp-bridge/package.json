{
  "name": "whatsapp-bridge",
  "version": "1.0.0",
  "description": "WhatsApp Web bridge for Seraphine — REST API + webhook",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "patch-package",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "patch-package": "^8.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
